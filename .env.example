# ---- Public URL of the site (used for share links and Open Graph images) ----
SITE_URL=https://legart.example.com

# ---- Supabase backend (leave all three empty to run in guest-only mode) ----
# Supabase dashboard → Project Settings → API (or your self-hosted Kong URL, e.g. https://supabase.example.com)
SUPABASE_URL=
# "anon" / publishable key — sent to browsers, safe to expose
SUPABASE_ANON_KEY=
# "service_role" / secret key — server only, NEVER expose it
SUPABASE_SERVICE_ROLE_KEY=

# ---- docker compose ----
# host port for the app (without the https profile)
WEB_PORT=3000
# domain for the Caddy https profile (DNS A/AAAA record must point to this server)
DOMAIN=legart.example.com
